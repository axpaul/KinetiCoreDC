	(text_box "• Monostable hold time: τ ≈ 10 ms (1MΩ / 10nF + fast discharge diode)\n• High-impedance tap: Does not load UART RX/TX lines"
		(exclude_from_sim no)
		(at 15.24 184.15 0)
		(size 96.52 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "33c4473c-0115-444a-908f-f473a691ad4c")
	)
	(text_box "• Input type: Dry contact to GND (Internal 2.2kΩ pull-up to +3.3V)\n• Debounce filter: Low-pass RC (10kΩ / 100nF, fc ≈ 160 Hz, τ = 1 ms)\n• Output: Inverted Schmitt-trigger logic (Active-HIGH at MCU when switch closed)"
		(exclude_from_sim no)
		(at 115.57 59.69 0)
		(size 102.87 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4b171f07-c464-4afe-a616-888cc4ae64a6")
	)
	(text_box "• Input: Quadrature A/B, 3.3V / 5V tolerant\n• HF Noise Filter: Low-pass RC (1kΩ / 1nF, fc ≈ 160 kHz, τ = 1 µs)\n• Output: Inverted Schmitt-trigger to STM32 TIM3_CH1/CH2"
		(exclude_from_sim no)
		(at 15.24 59.69 0)
		(size 96.52 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4d572482-86d1-4dab-95be-5a71c33e9548")
	)
	(text_box "• Bus specs: Half-duplex up to 500 kbps (Slew-rate limited, 120Ω terminated)\n• Common-mode protection: -7V to +12V (SM712 TVS + 10Ω series)\n• Control: DE/RE tied together (Default RX mode via 10kΩ pull-down)"
		(exclude_from_sim no)
		(at 15.24 127 0)
		(size 96.52 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5bd1b276-8cf4-4f3b-9693-22438cf70922")
	)
	(text_box "• Input range: 3V3 to 5V differential (R_series = 660Ω, ~2.73mA @ 3V3)\n• Max frequency: 5 Mbps (Push-pull output, active-high)\n• Protection: Reverse/Overvoltage clamp at 6.0V (SMAJ6.0A)"
		(exclude_from_sim no)
		(at 199.39 127 0)
		(size 80.01 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
