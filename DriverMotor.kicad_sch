		(uuid "51b4171b-bd72-43f2-927f-0ed6e604cdd9")
	)
	(text_box "• Operating range: VM = 5.1V to 18V | I_peak = 6A\n• Current limit (I_TRIP): ~2.6A (VREF = 2.50V via 15k/47k divider, R_IPROPI = 2.49kΩ)\n• Current sense (IPROPI): 455 µA/A → ~1.13 V/A (RC filter fc ≈ 16 kHz)\n• Control mode: PMODE selectable | NFAULT: Open-drain (10kΩ pull-up)"
		(exclude_from_sim no)
		(at 21.59 121.9978 0)
		(size 102.87 10.0822)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "56686000-f734-4994-8644-0f052d86ef8c")
	)
	(text_box "• Input type: Dry contact to GND (Internal 2.2kΩ pull-up to +3.3V)\n• Debounce filter: Low-pass RC (10kΩ / 100nF, fc ≈ 160 Hz, τ = 1 ms)\n• Output: Inverted Schmitt-trigger logic (Active-HIGH at MCU when switch closed)"
		(exclude_from_sim no)
		(at 128.27 123.19 0)
		(size 102.87 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5aafec6d-4e37-4430-b63f-1565a81f0a4a")
	)
	(text_box "• Input: Quadrature A/B, 3.3V / 5V tolerant\n• HF Noise Filter: Low-pass RC (1kΩ / 1nF, fc ≈ 160 kHz, τ = 1 µs)\n• Output: Inverted Schmitt-trigger to STM32 TIM3_CH1/CH2"
		(exclude_from_sim no)
		(at 128.27 66.04 0)
		(size 102.87 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
