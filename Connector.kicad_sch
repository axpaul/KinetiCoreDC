			)
			(justify left top)
		)
		(uuid "af33b133-e00f-421b-88b8-2392119da590")
	)
	(text_box "• ON (Pin 1 - NC): Pulled HIGH to VIN \n• OFF (Pin 3 - GND): Pulls SHDN_EXT LOW, disabling input MOSFETs (< 10 µA sleep)"
