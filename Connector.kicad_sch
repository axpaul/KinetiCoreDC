				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a098c52d-92ba-4048-930a-473c4f3ea22f")
	)
	(text_box "• I²C Pull-Ups: Populate ONLY for I²C operation\n• SPI Mode: Do Not Populate (DNP / NC) if SPI interface is used"
		(exclude_from_sim no)
		(at 95.25 104.14 0)
		(size 50.8 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
